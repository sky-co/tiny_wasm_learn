{
    "workbench.colorCustomizations": {
        "activityBar.activeBorder": "#e7e7e7",
        "activityBarTop.activeBorder": "#e7e7e7",
        "tab.activeForeground": "#ffffff",
        "tab.inactiveBackground": "#1e1e1e",
        "tab.inactiveForeground": "#8a8a8a",
        "tab.hoverBackground": "#163a5f",
        "tab.hoverForeground": "#ffffff",
        "tab.activeBorderTop": "#ffcc00",
        "tab.unfocusedActiveBackground": "#012141",
        "tab.unfocusedActiveForeground": "#d6d6d6",
        "tab.unfocusedInactiveForeground": "#6e6e6e",
        "tab.unfocusedActiveBorder": "#ffcc00",
        "tab.unfocusedActiveBorderTop": "#ffcc00",
        "statusBar.inactiveBackground": "#215732",
        "activityBar.activeBackground": "#fa1b49",
        "activityBar.background": "#fa1b49",
        "activityBar.foreground": "#e7e7e7",
        "activityBar.inactiveForeground": "#e7e7e799",
        "activityBarBadge.background": "#155e02",
        "activityBarBadge.foreground": "#e7e7e7",
        "activityBarTop.activeBackground": "#fa1b49",
        "activityBarTop.background": "#fa1b49",
        "activityBarTop.foreground": "#e7e7e7",
        "activityBarTop.inactiveForeground": "#e7e7e799",
        "commandCenter.border": "#e7e7e799",
        "commandCenter.foreground": "#e7e7e7",
        "sash.hoverBorder": "#fa1b49",
        "statusBar.background": "#dd0531",
        "statusBar.debuggingBackground": "#dd0531",
        "statusBar.debuggingForeground": "#e7e7e7",
        "statusBar.foreground": "#e7e7e7",
        "statusBarItem.hoverBackground": "#fa1b49",
        "statusBarItem.remoteBackground": "#0e3e01",
        "statusBarItem.remoteForeground": "#e7e7e7",
        "titleBar.activeBackground": "#dd0531",
        "titleBar.activeForeground": "#e7e7e7",
        "titleBar.inactiveBackground": "#dd053199",
        "titleBar.inactiveForeground": "#e7e7e799"
    },
    "peacock.color": "#215732",
    "clangd.enable": false,
    "clangd.detectExtensionConflicts": false,
    "C_Cpp.intelliSenseEngine": "default",
    "C_Cpp.intelliSenseEngineFallback": "enabled",
    "C_Cpp.autocomplete": "default",
    "C_Cpp.errorSquiggles": "disabled",
    "C_Cpp.default.compilerPath": "/usr/bin/aarch64-linux-gnu-g++",
    "C_Cpp.default.systemIncludePath": [
        "/usr/aarch64-linux-gnu/include/c++/13",
        "/usr/aarch64-linux-gnu/include/c++/13/aarch64-linux-gnu",
        "/usr/aarch64-linux-gnu/include/c++/13/backward",
        "/usr/lib/gcc-cross/aarch64-linux-gnu/13/include",
        "/usr/aarch64-linux-gnu/include",
        "/usr/include"
    ],
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.cStandard": "c11",
    "C_Cpp.default.intelliSenseMode": "linux-gcc-arm64",
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/Chapter*/**",
        "${workspaceFolder}/com/**"
    ],
    "C_Cpp.default.browse.path": [
        "${workspaceFolder}/Chapter00",
        "${workspaceFolder}/Chapter01",
        "${workspaceFolder}/Chapter02",
        "${workspaceFolder}/Chapter03",
        "${workspaceFolder}/Chapter04",
        "${workspaceFolder}/Chapter05",
        "${workspaceFolder}/com"
    ],
    "C_Cpp.default.browse.limitSymbolsToIncludedHeaders": false,
    "C_Cpp.workspaceParsingPriority": "medium",
    "C_Cpp.workspaceSymbols": "All",
    "files.watcherExclude": {
        "**/build/**": true,
        "**/.cache/**": true,
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true
    },
    "search.exclude": {
        "**/build/**": true,
        "**/.cache/**": true
    },
    "files.associations": {
        "*.hpp": "cpp"
    },
    "editor.inlineSuggest.enabled": true,
    "github.copilot.enable": {
        "*": true
    },
    "editor.multiCursorModifier": "alt",
    "editor.definitionLinkOpensInPeek": false,
    "editor.gotoLocation.multipleDefinitions": "goto",
    "editor.gotoLocation.multipleDeclarations": "goto",
    "debug.allowBreakpointsEverywhere": true,
    "peacock.remoteColor": "#dd0531"
}
